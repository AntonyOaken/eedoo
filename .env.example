# Copy to .env on the server; generate unique secrets before starting.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://poputi:CHANGE_ME@db:5432/poputi
REDIS_URL=redis://redis:6379
CATALOG_BACKEND=postgres
APP_ORIGIN=http://localhost:8080
TRUST_PROXY=1
DB_POOL_SIZE=10
# Own/dedicated providers; empty router enables client worker fallback.
VALHALLA_URL=
PHOTON_URL=
TILE_URL=
TILE_ATTRIBUTION=© OpenStreetMap contributors
MEDIA_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
METRICS_TOKEN=CHANGE_ME
